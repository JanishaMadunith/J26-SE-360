# J26-SE-360 environment — copy to `.env` (never commit `.env`).
#   cp .env.example .env
# Values below work for local development with `make up` (Docker Compose service names are the hostnames).

# ---------------------------------------------------------------- PostgreSQL (TimescaleDB image)
POSTGRES_USER=wellness
POSTGRES_PASSWORD=wellness_dev_pw
POSTGRES_DB=wellness
# Core API connection string. Running the API outside Docker? use @localhost:5432 instead of @postgres:5432
DATABASE_URL=postgresql+psycopg://wellness:wellness_dev_pw@postgres:5432/wellness

# ---------------------------------------------------------------- Redis (cache of latest forecasts / fallbacks)
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- Auth (JWT)
# CHANGE for any shared or deployed environment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------- Module services (called only by the core API)
M1_URL=http://m1-affective-state:8101
M2_URL=http://m2-wellness-prediction:8102
M3_URL=http://m3-schedule-optimizer:8103
M4_URL=http://m4-food-recommendation:8104
# Per-call timeout; on timeout/failure the core API falls back to the last stored result
MODULE_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- Pipeline (M1 -> M2 -> M3 -> M4)
# Minimum minutes between automatic runs triggered by sensor uploads (per user)
PIPELINE_MIN_INTERVAL_MINUTES=15
# Raw-signal window given to Module 1
PIPELINE_WINDOW_MINUTES=60

# ---------------------------------------------------------------- HTTP
# Comma-separated origins allowed by CORS ("*" for local development only)
CORS_ORIGINS=*

# ---------------------------------------------------------------- Research code (not used by Docker)
# Path to the shared datasets folder that sits NEXT TO the repo (data never goes in git)
DATA_DIR=../07-datasets
