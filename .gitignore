# ---------- secrets / local config
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
google-services.json

# ---------- data & research artifacts (never commit data — see CONTRIBUTING §9)
07-datasets/
/data/
services/*/data/
backend/*/data/
*.csv
*.csv.gz
*.tsv
*.parquet
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.db
*.sqlite
*.sqlite3
# tiny hand-made test fixtures are allowed
!**/tests/fixtures/**
# trained models: keep only the model card (scoped to services so code folders named "models" are unaffected)
services/*/models/*
!services/*/models/model_card.json
!services/*/models/.gitkeep
# small Module 3 demo files (derived, a few hundred KB) so the demo works from a clone
!services/m3-schedule-optimizer/models/completion_defaults.json
!services/m3-schedule-optimizer/models/demo_examples.json
!services/m3-schedule-optimizer/models/atus_day_profiles.json
!services/m3-schedule-optimizer/models/pmdata_wellness_days.json
# training reports can be large; keep markdown + figures, drop raw prediction dumps
services/*/reports/*.csv.gz

